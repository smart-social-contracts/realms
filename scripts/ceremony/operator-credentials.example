# Realms key ceremony — operator PIV credentials
#
# Copy to a private path, edit, then use with offline-generate BEFORE generating keys:
#   cp operator-credentials.example /tmp/my-piv.txt && chmod 600 /tmp/my-piv.txt
#   sudo ./realms-key-ceremony.sh offline-generate --credentials-file /tmp/my-piv.txt
#
# Or: export CEREMONY_OPERATOR_CREDENTIALS_FILE=/tmp/my-piv.txt
#
# Do NOT commit real credentials. Record values on paper at finalize; shred the file at destroy.
#
# PIV_PIN:            6–8 characters (digits recommended) — used for signing / dfx HSM
# PIV_PUK:            6–8 characters — unlocks PIN after too many wrong attempts
# PIV_MANAGEMENT_KEY: optional 48 hex chars (24 bytes). Omit to generate a random key.

PIV_PIN=123456
PIV_PUK=12345678
# PIV_MANAGEMENT_KEY=010203040506070801020304050607080102030405060708

# If your YubiKey already has a custom PIV PIN (not factory 123456), use at provision time:
#   CEREMONY_PIV_RESET=1 sudo -E ./realms-key-ceremony.sh provision-prod
# (piv reset wipes PIV slots/PIN/PUK/mgmt without asking for the old PIN; FIDO/OTP unchanged)
# Or migrate: CEREMONY_CURRENT_PIV_PIN='existing-pin' sudo -E ./realms-key-ceremony.sh provision-prod
