# Realms key ceremony — operator PIV credentials (copy to a private path, edit, then use with
# offline-generate --credentials-file or CEREMONY_OPERATOR_CREDENTIALS_FILE).
#
# Do NOT commit real credentials. Shred the file after recording values on paper.
#
# PIV_PIN:     6–8 characters (digits recommended)
# PIV_PUK:     6–8 characters
# PIV_MANAGEMENT_KEY: optional 48 hex chars (24 bytes). Omit to generate a random key.

PIV_PIN=123456
PIV_PUK=12345678
# PIV_MANAGEMENT_KEY=010203040506070801020304050607080102030405060708
