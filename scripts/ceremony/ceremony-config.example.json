{
  "ceremony_version": "1.0.0",
  "description": "Example — copy to ceremony-config.json and edit for your fleet",
  "piv": {
    "slot": "9c",
    "pkcs11_key_id": "02",
    "pkcs11_lib": "/usr/lib/x86_64-linux-gnu/libykcs11.so",
    "pin_policy": "once",
    "ec_curve": "prime256v1"
  },
  "environments": [
    {
      "id": "dev",
      "description": "Non-production IC networks",
      "signing_key": "dev-signing-key.pem",
      "export_private_pem": true,
      "yubikey": {
        "label": "YubiKey 5C Nano",
        "touch_policy": "never",
        "copies": 1
      }
    },
    {
      "id": "staging",
      "description": "Optional extra environment (add/remove as needed)",
      "signing_key": "staging-signing-key.pem",
      "yubikey": {
        "label": "YubiKey 5C",
        "touch_policy": "cached",
        "copies": 1
      }
    },
    {
      "id": "prod",
      "description": "Production IC network",
      "signing_key": "prod-signing-key.pem",
      "yubikey": {
        "label": "YubiKey 5 NFC",
        "touch_policy": "cached",
        "copies": 5
      }
    }
  ]
}
