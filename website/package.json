{
  "name": "realms-gos-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:website && npm run build:docs && npm run merge:docs",
    "build:website": "vite build",
    "build:docs": "cd ../docs && npm install --include=dev && npm run docs:build",
    "merge:docs": "mkdir -p dist/docs && cp -r ../docs/.vitepress/dist/* dist/docs/",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dfinity/agent": "^3.4.3",
    "@dfinity/auth-client": "^3.4.3",
    "@dfinity/principal": "^3.4.3",
    "i18next": "^25.7.3",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^16.5.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "vite": "^6.4.3"
  },
  "overrides": {
    "rollup": "^4.59.0",
    "esbuild": "^0.28.1"
  }
}
