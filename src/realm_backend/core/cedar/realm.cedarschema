        filed_date?: String,
        grounds?: String,
        id?: String,
        metadata?: String,
        status?: String,
        appellant?: User,
        appellate_court?: Court,
        new_verdict?: Verdict,
        original_case?: Case,
        original_verdict?: Verdict,
    };

    entity Appointment {
