{
  "version": 2,
  "name": "realms-product",
  "description": "Realms product orchestra: the marketplace, the fleet file registry (extensions, codices, catalogs), and the RLM token and NFT canisters.",
  "environments": {
    "local": {
      "network": "local",
      "dns": {
        "provider": "none"
      },
      "marketplace_host": "",
      "principals": {
        "operator": "$deployer"
      },
      "cycles": {
        "budget_tc": 300
      }
    },
    "production": {
      "network": "ic",
      "$comment": "operator is prod-identity (YubiKey). Deploy through an icp delegation from it. DNS lives in the Cloudflare zone realmsgos.org; the API token is read from $CLOUDFLARE_API_TOKEN, never written here.",
      "dns": {
        "provider": "cloudflare",
        "zone": "realmsgos.org",
        "token_env": "CLOUDFLARE_API_TOKEN",
        "ttl": 60
      },
      "marketplace_host": "realmsgos.org",
      "principals": {
        "operator": "rd4en-sizpv-vnamr-6vbfc-uljz5-vvz7c-g4nzy-uflq2-zbj3x-mrwjs-gqe",
        "$comment_deployer": "The identity that ran casals up. It is a controller of the governance multisig only.",
        "deployer": "$deployer"
      },
      "cycles": {
        "budget_tc": 20
      }
    }
  },
  "conductor": {
    "backend": {
      "wasm": "casals-backend",
      "kind": "backend",
      "mode": "managed",
      "controllers": [
        "$multisig"
      ]
    },
    "frontend": {
      "wasm": "casals-frontend",
      "kind": "frontend",
      "mode": "managed",
      "content": "frontend/casals-ui/main",
      "controllers": [
        "$self",
        "$multisig"
      ]
    },
    "store": {
      "wasm": "certified-assets@0.3.0",
      "kind": "frontend",
      "mode": "managed",
      "controllers": [
        "$self",
        "$multisig"
      ]
    },
    "commanders": [
      {
        "principal": "$principal:operator",
        "permissions": "*"
      }
    ],
    "settings": {
      "orchestra_name": "realms-product"
    }
  },
  "governance": {
    "multisig": {
      "wasm": "orchestration-multisig@1.6.0",
      "kind": "backend",
      "mode": "managed",
      "signers": [
        "$principal:operator"
      ],
      "threshold": 1,
      "controllers": [
        "$multisig",
        "$deployer"
      ]
    }
  },
  "domains": [
    {
      "host": "$env.marketplace_host",
      "canister": "marketplace-frontend"
    }
  ],
  "registry": {
    "wasms": [
      {
        "family": "casals-backend",
        "version": "main",
        "source": "release:smart-social-contracts/Casals@v0.3.3:casals_backend.wasm.gz",
        "sha256": "1dce5edb5766123b64b820b6d2c1d38417c68601b6bf46daf4edc4b907f4748b"
      },
      {
        "family": "certified-assets",
        "version": "0.3.0",
        "source": "release:smart-social-contracts/Casals@v0.3.2:certified-assets@0.3.0.wasm.gz",
        "sha256": "75df75f39763077fd0333b4ac46ba03b2b23ec313fa85f79a2097bd98bb363d1"
      },
      {
        "family": "certified-assets",
        "version": "1.0.0",
        "source": "release:smart-social-contracts/Casals@v0.3.2:certified-assets@1.0.0.wasm.gz",
        "sha256": "63d122d0149a29f4e48603efdd7d2bce656a6a83bac1e3207897c68e8e225bb6"
      },
      {
        "family": "orchestration-multisig",
        "version": "1.6.0",
        "source": "release:smart-social-contracts/Casals@v0.3.2:orchestration-multisig@1.6.0.wasm.gz",
        "sha256": "c8d3adecf9bea8d9e7811cfa5d9eda8f61723c770f85132b91c8b2cffb37974f"
      },
      {
        "family": "file-registry",
        "version": "main",
        "source": "release:smart-social-contracts/gos-as-a-service@v0.3.4:file_registry.wasm.gz",
        "sha256": "2cd95df0c9200480a3094fc8985e402708ff8712f727ebd5204f6e93d7762153"
      },
      {
        "family": "marketplace-backend",
        "version": "main",
        "source": "local:.basilisk/marketplace_backend/marketplace_backend.wasm"
      },
      {
        "family": "token-backend",
        "version": "0.1.0",
        "source": "release:smart-social-contracts/realms@v0.5.1:token_backend.wasm.gz",
        "sha256": "a1734ad2ec260ce85e541f860dbcaf8c846423709177587c7e5f70adc47e461a"
      },
      {
        "family": "nft-backend",
        "version": "0.1.0",
        "source": "local:.external-wasms/nft_backend.wasm",
        "sha256": "497af917df8190c039d9c0c888c36a6c626c612847c31e43231cf4634f07aad6"
      }
    ],
    "bundles": [
      {
        "path": "frontend/marketplace-assets/main",
        "source": "local:src/marketplace_frontend/dist"
      },
      {
        "path": "frontend/file-registry-assets/main",
        "source": "local:../file-registry/frontend/dist"
      },
      {
        "path": "frontend/casals-ui/main",
        "source": "release:smart-social-contracts/Casals@v0.3.3:casals_frontend.tar.gz",
        "sha256": "ddcbbcf11cefb2560cb8226f35f282b7f8652b70ef698173c910022342f25cdb"
      }
    ]
  },
  "sections": [
    {
      "name": "Product",
      "description": "Marketplace (realmsgos.org), the fleet file registry, and the RLM token and NFT canisters. Realm stands are minted by GaaS, not by this orchestra.",
      "stands": [
        {
          "name": "marketplace",
          "canisters": [
            {
              "name": "marketplace-backend",
              "kind": "backend",
              "mode": "managed",
              "wasm": "marketplace-backend@main",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "config": [
                {
                  "method": "set_file_registry_canister_id",
                  "args": "$canister:fleet-file-registry",
                  "converged_when": {
                    "query": "get_file_registry_canister_id_q",
                    "equals": "$canister:fleet-file-registry"
                  }
                },
                {
                  "method": "set_casals_frontend_canister_id",
                  "args": "$canister:casals-frontend",
                  "converged_when": {
                    "query": "get_casals_frontend_canister_id_q",
                    "equals": "$canister:casals-frontend"
                  }
                },
                {
                  "method": "admin_grant_publisher",
                  "args": {
                    "principal": "$principal:operator",
                    "duration_seconds": 315360000,
                    "note": "operator (sheet)",
                    "reviewer": true
                  },
                  "converged_when": {
                    "query": "admin_status",
                    "contains": {
                      "licensed": [
                        "$principal:operator"
                      ],
                      "reviewers": [
                        "$principal:operator"
                      ]
                    }
                  }
                }
              ]
            },
            {
              "name": "marketplace-frontend",
              "kind": "frontend",
              "mode": "managed",
              "wasm": "certified-assets@1.0.0",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "content": "frontend/marketplace-assets/main",
              "files": {
                "/canister_ids.js": "globalThis.__CANISTER_IDS = {\"marketplace_backend\": \"$stand.backend\", \"file_registry\": \"$canister:fleet-file-registry\"};\n"
              },
              "health": [
                {
                  "http": "/index.html",
                  "status": 200
                }
              ]
            }
          ]
        },
        {
          "name": "file-registry",
          "description": "Fleet registry: extension packages, codices, catalogs, and the approvals the marketplace stamps.",
          "canisters": [
            {
              "name": "fleet-file-registry",
              "kind": "backend",
              "mode": "managed",
              "wasm": "file-registry@main",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "config": [
                {
                  "method": "grant_publish",
                  "args": {
                    "namespace": "*",
                    "principal": "$principal:operator"
                  },
                  "converged_when": {
                    "query": "get_acl",
                    "contains": {
                      "*": [
                        "$principal:operator"
                      ]
                    }
                  }
                },
                {
                  "method": "grant_publish",
                  "args": {
                    "namespace": "_approvers",
                    "principal": "$canister:marketplace-backend"
                  },
                  "converged_when": {
                    "query": "get_acl",
                    "contains": {
                      "_approvers": [
                        "$canister:marketplace-backend"
                      ]
                    }
                  }
                }
              ]
            },
            {
              "name": "fleet-file-registry-frontend",
              "kind": "frontend",
              "mode": "managed",
              "wasm": "certified-assets@1.0.0",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "content": "frontend/file-registry-assets/main",
              "files": {
                "/canister_ids.js": "globalThis.__CANISTER_IDS = {\"file_registry\": \"$canister:fleet-file-registry\"};\n"
              },
              "health": [
                {
                  "http": "/index.html",
                  "status": 200
                }
              ]
            }
          ]
        },
        {
          "name": "token",
          "canisters": [
            {
              "name": "token-backend",
              "kind": "backend",
              "mode": "managed",
              "wasm": "token-backend@0.1.0",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "install_arg": "(record { name = \"Realms Token\"; symbol = \"RLM\"; decimals = 8 : nat8; total_supply = 100_000_000_000_000_000 : nat; fee = 10_000 : nat; test = opt false })"
            }
          ]
        },
        {
          "name": "nft",
          "canisters": [
            {
              "name": "nft-backend",
              "kind": "backend",
              "mode": "managed",
              "wasm": "nft-backend@0.1.0",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "install_arg": "(record { name = \"Realms NFT\"; symbol = \"RNFT\"; description = opt \"Realms NFT collection\"; supply_cap = null; test = opt false })"
            }
          ]
        }
      ]
    }
  ],
  "cycles": {
    "min_balance_tc": 0.5,
    "top_up_from": "$self",
    "conductor_min_balance_tc": 5.0
  }
}
