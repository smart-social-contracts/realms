{
  "version": 2,
  "name": "realms-product",
  "description": "Realms product surface on its own conductor (Realms GOS Casals): marketplace, fleet file registry, token and NFT canisters, plus a demo realm stand running the real realm wasm. `casals up casals.json -e <env>` builds and reconciles all of it.",
  "environments": {
    "local": {
      "network": "local",
      "dns": {
        "provider": "none"
      },
      "portal_url": "http://localhost:8000",
      "marketplace_host": "",
      "build_variant": "test",
      "test_flags": {
        "test_mode": true,
        "ii_bypass": true,
        "user_self_registration": true,
        "demo_data": false,
        "skip_terms": true
      },
      "principals": {
        "operator": "$deployer",
        "billing_service": "$deployer"
      },
      "cycles": {
        "min_balance_tc": 0.5,
        "budget_tc": 300
      }
    },
    "production": {
      "network": "ic",
      "dns": {
        "provider": "cloudflare",
        "zone": "realmsgos.org",
        "token_env": "CLOUDFLARE_API_TOKEN",
        "ttl": 60
      },
      "portal_url": "https://gos.earth",
      "marketplace_host": "realmsgos.org",
      "build_variant": "production",
      "test_flags": {
        "test_mode": false,
        "ii_bypass": false
      },
      "principals": {
        "operator": "rd4en-sizpv-vnamr-6vbfc-uljz5-vvz7c-g4nzy-uflq2-zbj3x-mrwjs-gqe",
        "billing_service": "rd4en-sizpv-vnamr-6vbfc-uljz5-vvz7c-g4nzy-uflq2-zbj3x-mrwjs-gqe",
        "signer_2": "g53u4-3liee-2f7qe-m2b6g-p3bpg-6aatl-cnhs3-drrzi-fllp4-qxfgh-hqe",
        "signer_3": "55alf-xclhd-rtshz-lk4lo-wav4q-q3a5e-sktkm-zlshq-vvhjs-re6os-wae"
      },
      "cycles": {
        "min_balance_tc": 2.0,
        "budget_tc": 20
      }
    }
  },
  "conductor": {
    "backend": {
      "wasm": "casals-backend",
      "kind": "backend",
      "mode": "managed",
      "controllers": [
        "$multisig"
      ]
    },
    "frontend": {
      "wasm": "casals-frontend",
      "kind": "frontend",
      "mode": "managed",
      "controllers": [
        "$multisig"
      ]
    },
    "file_registry": {
      "wasm": "file-registry",
      "kind": "backend",
      "mode": "managed",
      "controllers": [
        "$self"
      ],
      "cycles": {
        "min_balance_tc": 30
      }
    },
    "file_registry_frontend": {
      "wasm": "file-registry-frontend",
      "kind": "frontend",
      "mode": "managed",
      "controllers": [
        "$self"
      ]
    },
    "commanders": [
      {
        "principal": "$principal:operator",
        "permissions": "*"
      }
    ],
    "settings": {
      "orchestra_name": "realms-product"
    }
  },
  "governance": {
    "multisig": {
      "wasm": "orchestration-multisig@1.5.0",
      "kind": "backend",
      "mode": "managed",
      "signers": [
        "$principal:operator"
      ],
      "threshold": 1,
      "controllers": [
        "$multisig"
      ]
    }
  },
  "domains": [
    {
      "host": "$env.marketplace_host",
      "canister": "marketplace-frontend"
    }
  ],
  "registry": {
    "$comment": "Product wasms are built in this repo before `casals up` (local:; recipes: .github/workflows/release.yml build steps); conductor wasms by the Casals CLI (build:); ic-tokens wasms are the v0.1.0 release copies in .external-wasms.",
    "wasms": [
      {
        "family": "casals-backend",
        "version": "main",
        "source": "build:casals_backend"
      },
      {
        "family": "file-registry",
        "version": "main",
        "source": "build:ic_file_registry"
      },
      {
        "family": "orchestration-multisig",
        "version": "1.5.0",
        "source": "local:seed/templates/orchestration-multisig@1.5.0.wasm.gz"
      },
      {
        "family": "certified-assets",
        "version": "1.0.0",
        "source": "local:seed/templates/hello-world-frontend.wasm.gz"
      },
      {
        "family": "marketplace-backend",
        "version": "main",
        "source": "local:.basilisk/marketplace_backend/marketplace_backend.wasm"
      },
      {
        "family": "realm-backend",
        "version": "main",
        "source": "local:.basilisk/realm_backend/realm_backend.wasm"
      },
      {
        "family": "token-backend",
        "version": "0.1.0",
        "source": "local:.external-wasms/token_backend.wasm"
      },
      {
        "family": "nft-backend",
        "version": "0.1.0",
        "source": "local:.external-wasms/nft_backend.wasm"
      }
    ],
    "publish": [
      {
        "path": "frontend/marketplace-assets/main",
        "source": "local:src/marketplace_frontend/dist"
      },
      {
        "path": "frontend/realm-assets/main",
        "source": "local:src/realm_frontend/dist"
      }
    ]
  },
  "sections": [
    {
      "name": "Product",
      "description": "Marketplace, fleet file registry, token and NFT canisters.",
      "stands": [
        {
          "name": "marketplace",
          "canisters": [
            {
              "name": "marketplace-backend",
              "kind": "backend",
              "mode": "managed",
              "wasm": "marketplace-backend@main",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "config": [
                {
                  "method": "set_file_registry_canister_id",
                  "args": "$canister:fleet-file-registry",
                  "converged_when": {
                    "query": "get_file_registry_canister_id_q",
                    "equals": "$canister:fleet-file-registry"
                  }
                },
                {
                  "method": "set_casals_frontend_canister_id",
                  "args": "$canister:casals-frontend",
                  "converged_when": {
                    "query": "get_casals_frontend_canister_id_q",
                    "equals": "$canister:casals-frontend"
                  }
                },
                {
                  "method": "set_billing_service_principal",
                  "args": "$principal:billing_service",
                  "converged_when": {
                    "query": "get_billing_service_principal_q",
                    "equals": "$principal:billing_service"
                  }
                }
              ]
            },
            {
              "name": "marketplace-frontend",
              "kind": "frontend",
              "mode": "managed",
              "wasm": "certified-assets@1.0.0",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "content": "frontend/marketplace-assets/main",
              "files": {
                "/canister_ids.js": "globalThis.__CANISTER_IDS = {\"marketplace_backend\": \"$stand.backend\", \"file_registry\": \"$canister:fleet-file-registry\"};\n"
              },
              "health": [
                {
                  "http": "/index.html",
                  "status": 200
                }
              ]
            }
          ]
        },
        {
          "name": "file-registry",
          "description": "Fleet file registry (realm branding, extensions, catalogs) — not the conductor's own.",
          "canisters": [
            {
              "name": "fleet-file-registry",
              "kind": "backend",
              "mode": "managed",
              "wasm": "file-registry@main",
              "controllers": [
                "$self",
                "$multisig"
              ]
            },
            {
              "name": "fleet-file-registry-frontend",
              "kind": "frontend",
              "mode": "managed",
              "wasm": "certified-assets@1.0.0",
              "controllers": [
                "$self",
                "$multisig"
              ]
            }
          ]
        },
        {
          "name": "token",
          "canisters": [
            {
              "name": "token-backend",
              "kind": "backend",
              "mode": "managed",
              "wasm": "token-backend@0.1.0",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "install_arg": "(record { name = \"Realms Token\"; symbol = \"RLM\"; decimals = 8 : nat8; total_supply = 100_000_000_000_000_000 : nat; fee = 10_000 : nat; test = opt true })"
            }
          ]
        },
        {
          "name": "nft",
          "canisters": [
            {
              "name": "nft-backend",
              "kind": "backend",
              "mode": "managed",
              "wasm": "nft-backend@0.1.0",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "install_arg": "(record { name = \"Realms NFT\"; symbol = \"RNFT\"; description = opt \"Realms NFT collection\"; supply_cap = null; test = opt true })"
            }
          ]
        }
      ]
    },
    {
      "name": "Realms",
      "description": "Demo realm running the real realm wasm and frontend, configured against the fleet file registry and the marketplace.",
      "stands": [
        {
          "name": "demo",
          "canisters": [
            {
              "name": "demo-backend",
              "kind": "backend",
              "mode": "managed",
              "wasm": "realm-backend@main",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "config": [
                {
                  "method": "set_canister_config_json",
                  "args": {
                    "frontend_canister_id": "$stand.frontend",
                    "file_registry_canister_id": "$canister:fleet-file-registry",
                    "marketplace_canister_id": "$canister:marketplace-backend",
                    "network": "$env.network",
                    "test_flags": "$env.test_flags"
                  },
                  "converged_when": {
                    "query": "get_runtime_flags",
                    "contains": {
                      "network": "$env.network",
                      "build_variant": "$env.build_variant",
                      "test_mode": "$env.test_flags.test_mode"
                    }
                  }
                }
              ],
              "health": [
                {
                  "query": "get_runtime_flags",
                  "expect": {
                    "success": true
                  }
                }
              ]
            },
            {
              "name": "demo-frontend",
              "kind": "frontend",
              "mode": "managed",
              "wasm": "certified-assets@1.0.0",
              "controllers": [
                "$self",
                "$multisig"
              ],
              "content": "frontend/realm-assets/main",
              "files": {
                "/canister_ids.js": "globalThis.__CANISTER_IDS = {\"realm_backend\": \"$stand.backend\", \"file_registry\": \"$canister:fleet-file-registry\", \"test_mode_ii_bypass\": $env.test_flags.ii_bypass};\n"
              },
              "health": [
                {
                  "http": "/index.html",
                  "status": 200
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "cycles": {
    "min_balance_tc": 0.5,
    "top_up_from": "$self",
    "conductor_min_balance_tc": 5.0
  }
}
